PROJECT_NAME="Employee Work & Weekly Reporting System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Secret Key - Change for production deployment
JWT_SECRET_KEY="supersecret_jwt_key_bharatrohan_development_change_in_production_123456"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB URI (Supports MongoDB Atlas or local MongoDB)
MONGODB_URI="mongodb://localhost:27017"
