PROJECT_NAME="Employee Work & Weekly Reporting System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# JWT Secret Key - Must be >= 32 chars and changed in production
JWT_SECRET_KEY="supersecret_jwt_key_bharatrohan_development_change_in_production_123456"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB URI (Supports MongoDB Atlas or local MongoDB; mock database only allowed in development)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="employee_reporting_db"

# Free-Tier AI Model Key (Gemini API: https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Security and Demo Toggles (Set ENABLE_DEMO_USERS=false in production)
ENABLE_DEMO_USERS=true
SEED_DEMO_ACCOUNTS=true

# CORS origins: specific allowed URLs (wildcards are blocked when ENVIRONMENT=production)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
